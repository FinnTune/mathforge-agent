# Copy to ".env" and fill in secrets. Never commit ".env".
# python-dotenv loads this file for both the server (grpc_server.py) and the
# clients (main.py, discord_bot.py) — but most of these variables are only
# read by the server; see "gRPC service" below for what clients actually need.

# --- Required (server only — grpc_server.py) ---
# Anthropic console: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Optional: LLM behavior (agent / Claude) ---
# Model id passed to ChatAnthropic (override default in config.load_settings).
# MATHFORGE_MODEL=claude-sonnet-4-6
# Sampling temperature (0 = deterministic-ish; higher = more random).
# MATHFORGE_TEMPERATURE=0
# Hard cap on completion tokens (leave unset for provider default).
# MATHFORGE_MAX_TOKENS=
# LangGraph recursion_limit: max node visits across the whole graph (planner,
# tools, verifier, responder all count).
# MATHFORGE_RECURSION_LIMIT=40
# Cap on planner<->verifier retry loops per turn (safety net against an
# endlessly unsatisfied verifier — see README "Agent design").
# MATHFORGE_VERIFICATION_MAX_ATTEMPTS=2
# Where the SQLite conversation-memory DB lives. Defaults to
# agent-core/.mathforge/checkpoints.sqlite3 relative to this repo checkout.
# MATHFORGE_CHECKPOINT_DB_PATH=

# --- Optional: code sandbox (mcp-servers/sandbox-rs, spoken to over MCP) ---
# Working directory for executed code; relative paths like ./plots/ resolve here.
# MATHFORGE_WORKSPACE_ROOT=.
# Seconds before the sandbox kills the child (also sets its CPU-time rlimit).
# MATHFORGE_CODE_TIMEOUT_SEC=30
# Path to the compiled sandbox MCP server binary. Defaults to
# mcp-servers/sandbox-rs/target/release/mathforge-sandbox-mcp relative to this
# repo checkout — override if you build/install it elsewhere.
# MATHFORGE_SANDBOX_MCP_BIN=
# Python interpreter the sandbox server invokes for the actual code — needs
# numpy/sympy/matplotlib/scipy installed (mcp-servers/sandbox-rs/requirements.txt).
# This is deliberately a *different* interpreter than the one running
# agent-core: agent-core itself no longer depends on the scientific stack.
# MATHFORGE_SANDBOX_PYTHON=python3
# RLIMIT_AS (address space) cap for the sandboxed process, in megabytes.
# MATHFORGE_SANDBOX_MAX_MEMORY_MB=512
# Cap on captured stdout+stderr kept in memory; excess is drained and discarded.
# MATHFORGE_SANDBOX_MAX_OUTPUT_BYTES=256000
# cgroup v2 pids.max for the sandboxed subtree — a real fork-bomb guard
# (opportunistic: needs a delegated cgroup v2 subtree, see README Security
# model; silently unused if unavailable on this host).
# MATHFORGE_SANDBOX_MAX_PROCESSES=64

# --- Optional: RAG knowledge base (mcp-servers/mathkb-py, spoken to over MCP) ---
# Voyage AI console: https://dash.voyageai.com/ — needed to run `ingest.py` and
# for the search_math_knowledge tool to actually retrieve anything (without it,
# the tool still loads fine but calls fail with a clear credentials error, and
# the agent falls back to answering without a retrieved note).
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3-lite
# Qdrant REST endpoint — run `docker compose up -d qdrant` for a local one.
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=mathforge-math-notes
# Interpreter/script for the mathkb MCP server. Defaults to
# mcp-servers/mathkb-py/.venv/bin/python and .../server.py relative to this
# repo checkout — override if you set up its venv elsewhere.
# MATHFORGE_MATHKB_MCP_PYTHON=
# MATHFORGE_MATHKB_MCP_SCRIPT=

# --- Optional: logging ---
# Python logging level name: DEBUG, INFO, WARNING, ERROR.
# MATHFORGE_LOG_LEVEL=INFO

# --- gRPC service (proto/chat.proto) ---
# Server bind address (grpc_server.py / `mathforge-server`).
# MATHFORGE_GRPC_HOST=127.0.0.1
# MATHFORGE_GRPC_PORT=50051
# Client target (main.py / discord_bot.py) — point this at the gateway
# (MATHFORGE_GATEWAY_HOST:PORT below) instead of the server directly to go
# through it. Everything else in this section is server-side only.
# MATHFORGE_GRPC_TARGET=127.0.0.1:50051
# Client-only: required if MATHFORGE_GRPC_TARGET points at the gateway (it
# requires x-api-key); unused/harmless talking directly to the server.
# MATHFORGE_GRPC_API_KEY=

# --- Optional: TLS for gRPC (server, gateway, and clients) — plaintext by
# default (all unset), matching prior behavior. Generate a throwaway
# self-signed dev cert with `scripts/generate_dev_certs.sh`; see README "TLS".
# Server-side identity (grpc_server.py) — both required together to enable.
# MATHFORGE_GRPC_TLS_CERT=certs/server.crt
# MATHFORGE_GRPC_TLS_KEY=certs/server.key
# Client-side (main.py / discord_bot.py): CA/cert PEM to trust, whether
# MATHFORGE_GRPC_TARGET points at grpc_server.py directly or at the gateway.
# MATHFORGE_GRPC_TLS_CA=certs/server.crt

# --- Optional: Rust gRPC gateway (gateway-rs) — auth + rate limiting in
# front of the server. Not required; clients can talk to the server directly.
# Gateway bind address.
# MATHFORGE_GATEWAY_HOST=127.0.0.1
# MATHFORGE_GATEWAY_PORT=50052
# The real server the gateway forwards to. Must use https:// if
# MATHFORGE_GATEWAY_UPSTREAM_TLS_CA below is set (tonic only performs the TLS
# handshake for an https:// endpoint).
# MATHFORGE_GATEWAY_UPSTREAM=http://127.0.0.1:50051
# Required to start the gateway (comma-separated) — clients send one of
# these as x-api-key metadata. No default; the gateway won't start without it.
# MATHFORGE_GATEWAY_API_KEYS=
# Per-API-key quota before the gateway returns RESOURCE_EXHAUSTED.
# MATHFORGE_GATEWAY_RATE_LIMIT_PER_MINUTE=30
# TLS for the gateway's own listening port (what clients connect to). Both
# required together to enable; unset (default) is plaintext.
# MATHFORGE_GATEWAY_TLS_CERT=certs/server.crt
# MATHFORGE_GATEWAY_TLS_KEY=certs/server.key
# TLS for the gateway's upstream connection (gateway -> grpc_server.py) — CA/
# cert PEM to trust. Requires MATHFORGE_GATEWAY_UPSTREAM=https://...  above.
# MATHFORGE_GATEWAY_UPSTREAM_TLS_CA=certs/server.crt
# Prometheus /metrics endpoint (gateway-rs only): request counters by outcome.
# MATHFORGE_GATEWAY_METRICS_HOST=127.0.0.1
# MATHFORGE_GATEWAY_METRICS_PORT=9090

# --- Optional: distributed tracing (grpc_server.py and gateway-rs both read
# this) — unset (default) means tracing is fully inert, no OTLP traffic; see
# README "Observability". `docker compose up -d jaeger` provides a local
# collector + UI at http://localhost:16686; Docker Compose sets this to
# http://jaeger:4317 for the `agent`/`gateway` services automatically.
# MATHFORGE_OTLP_ENDPOINT=http://localhost:4317

# --- Optional: Discord bot interface ---
# Bot token from Discord Developer Portal.
# DISCORD_BOT_TOKEN=
# Optional comma-separated allowlist of channel IDs. Empty means "all channels".
# DISCORD_ALLOWED_CHANNEL_IDS=123456789012345678,234567890123456789
# Max chars accepted from `/mathforge query:` to bound payload size.
# DISCORD_MAX_PROMPT_CHARS=4000
# Per-user cooldown in seconds (0 disables cooldown).
# DISCORD_USER_COOLDOWN_SEC=0
# Optional dev guild for faster slash-command sync while developing.
# DISCORD_DEV_GUILD_ID=

# --- Optional: LangSmith (LangChain observability) ---
# Docs: https://docs.smith.langchain.com/
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=mathforge
